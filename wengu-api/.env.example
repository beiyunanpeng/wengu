# wengu · 温故 后端环境变量模板
# 用法：cp wengu-api/.env.example wengu-api/.env → 填入真实值
# 安全：.env 已在 .gitignore 中；密钥绝不进仓库；日志绝不落题目全文/PII

# ============================================
# 运行时模式
# ============================================
WENGU_ENV=dev                        # dev | prod
WENGU_PORT=8000                      # 本机 8000 被 Windows 保留时用 make dev-api PORT=8100
WENGU_DATA_DIR=./data                # 相对 wengu-api/；Docker 内由 compose 覆盖为 /app/data
WENGU_UPLOADS_DIR=./data/uploads
WENGU_DB_PATH=./data/wengu.db        # SQLite 文件位置（WAL 会生成 .db-wal/.db-shm）
WENGU_LOG_LEVEL=info                 # debug | info | warning | error

# 提示词与热配置：默认取仓库根目录，Docker 内由 compose 覆盖为 /app/...
# WENGU_PROMPTS_DIR=../llm_prompts
# WENGU_SEEDS_DIR=../seeds            # 容器内 = /app/seeds（compose 已配好，一般不用动）
# WENGU_APP_CONFIG_PATH=../config/app-config.json

# 家长 PIN（哈希后存 config/app-config.json；.env 只放明文首启值，UI 改后走热配置）
WENGU_PARENT_PIN_CHANGE_ON_FIRST_BOOT=1

# ============================================
# 模型 Provider（至少启用两家做互备）
# 参考设计文档 §3、AGENTS §4
# ============================================

# ---- 火山引擎 · 豆包（主，与豆包爱学同源） ----
# 模型名分性价比/旗舰两档（AGENTS §4）：不填的那一档不允许路由到它，启动不猜、调用时 fail-fast。
# 注意：方舟模型需在控制台"开通"后才能调用（/models 能列出不等于已开通，未开通报 InvalidEndpointOrModel.NotFound）
# 注意：seed-2.1 是推理模型（usage 里有 reasoning_tokens），延迟/成本高于老 vision 系列，选型以 P1-4 黄金集实测为准
WENGU_DOUBAO_API_KEY=REPLACE_ME
WENGU_DOUBAO_MODEL_VALUE=doubao-seed-2-1-lite-260915    # 性价比档（默认走这档）
WENGU_DOUBAO_MODEL_FLAGSHIP=doubao-seed-2-1-pro-260915  # 旗舰档
# 另有 doubao-seed-2-1-turbo-260628；Phase 0 实测 turbo 反而比 lite 差、成本 5×、延迟 4×，默认不用

# ---- 阿里百炼 · Qwen（对照；Phase 0 实测字形默写占优，默写提取默认路由 qwen_vl） ----
# 模型 ID 全小写、大小写敏感（控制台展示名 Qwen3.5-OCR ≠ API 的 qwen3.5-ocr）
# 专属版/工作空间实例的 OpenAI 兼容地址是 .../compatible-mode/v1（不是 /api/v1）
WENGU_QWEN_API_KEY=REPLACE_ME
# WENGU_QWEN_BASE_URL=https://<工作空间>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
WENGU_QWEN_MODEL_VALUE=qwen3.5-ocr     # 性价比档（OCR/默写取向）
WENGU_QWEN_MODEL_FLAGSHIP=qwen3.8-max  # 旗舰档

# ---- 文本侧 · DeepSeek（OpenAI 兼容；GLM/Kimi 同走 OpenAITextProvider，后续加配置） ----
WENGU_DEEPSEEK_API_KEY=REPLACE_ME
# WENGU_DEEPSEEK_BASE_URL=https://api.deepseek.com
# WENGU_DEEPSEEK_MODEL=deepseek-chat

# ---- 腾讯教育批改（候选；P1-2 仅占位，路由到它会明确抛未实现） ----
# （暂无配置项）

# ---- 故障转移顺序（P1-2b） ----
# 单值字符串 = 只允许该家；列表 = 按顺序逐家尝试，每家最多 1 次，全失败才报错。
# 默认：extract_problem/grade/solve_explain = ["doubao","qwen_vl"]；
#       dictation_extract = ["qwen_vl","doubao"]；text = ["deepseek"]。
# app-config.json 的同名字段按任务整条覆盖这里（UI 改后无需重启）。
# 403/402/429/5xx/网络/配置缺失会切下一家；模型 200 但内容不可解析不切（质量问题）。
# WENGU_PROVIDER_ROUTING={"extract_problem":["doubao","qwen_vl"],"dictation_extract":["qwen_vl","doubao"]}

# ---- 按 task 配模型（P1-2c） ----
# 覆盖某任务在某 provider 上使用的模型（字面模型 ID，优先于档位默认）。
# 不配时的内置默认：
#   extract_problem/grade/solve_explain 的 qwen_vl -> WENGU_QWEN_MODEL_FLAGSHIP（VLM）
#   dictation_extract 的 qwen_vl -> WENGU_QWEN_MODEL_VALUE（OCR）
# 其余 provider/task 沿用 WENGU_MODEL_TIER_DEFAULT；显式模型缺失会 fail-fast。
# app-config.json 的 task_models 按 task 整条覆盖这里（UI 改后无需重启）。
# WENGU_TASK_MODELS={"extract_problem":{"qwen_vl":"qwen3.8-max"},"dictation_extract":{"qwen_vl":"qwen3.5-ocr"}}

# ============================================
# 成本护栏（AGENTS §4 必配；热配置见 config/app-config.json）
# ============================================
WENGU_DAILY_CALL_LIMIT=200           # 每日真实模型调用次数硬闸（缓存命中不计）
WENGU_DAILY_CALL_BUDGET_CNY=10       # 当日估算成本上限（按 model_prices 的 token 单价估）
WENGU_MODEL_TIER_DEFAULT=value       # value（性价比） | flagship（旗舰）
WENGU_VARIANT_ON_DEMAND=1            # 变式题必须按需触发，禁止后台自动刷

# 别忘了在**云厂商控制台**同步设置账单硬上限与告警——这不是本应用能替代的

# ============================================
# 可选：云备份（v2.4 KuroTutor 模式，AESGCM+scrypt+git 每日 commit）
# ============================================
# WENGU_BACKUP_ENABLED=0
# WENGU_BACKUP_REPO=https://gitee.com/<你>/wengu-backup.git
# WENGU_BACKUP_TOKEN=                # 私有仓库 PAT
# WENGU_BACKUP_PASSPHRASE=           # scrypt 加密口令，一旦丢失无法恢复

# ============================================
# 可选：远程访问（默认关，走 Tailscale 见 docker-compose.yml）
# ============================================
# TS_AUTHKEY=                        # 若启用 tailscale 服务
