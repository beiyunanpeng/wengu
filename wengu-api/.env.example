# wengu · 温故 后端环境变量模板
# 用法：cp wengu-api/.env.example wengu-api/.env → 填入真实值
# 安全：.env 已在 .gitignore 中；密钥绝不进仓库；日志绝不落题目全文/PII

# ============================================
# 运行时模式
# ============================================
WENGU_ENV=prod                       # dev | prod
WENGU_PORT=8000
WENGU_DATA_DIR=/app/data             # 容器内路径；本地开发可写 ./data
WENGU_UPLOADS_DIR=/app/data/uploads
WENGU_DB_PATH=/app/data/wengu.db     # SQLite 文件位置（WAL 会生成 .db-wal/.db-shm）
WENGU_LOG_LEVEL=info                 # debug | info | warning | error

# 家长 PIN（哈希后存 config/app-config.json；.env 只放明文首启值，UI 改后走热配置）
WENGU_PARENT_PIN_CHANGE_ON_FIRST_BOOT=1

# ============================================
# 模型 Provider（至少启用两家做互备）
# 参考设计文档 §3、AGENTS §4
# ============================================

# ---- 火山引擎 · 豆包（主，与豆包爱学同源） ----
DOUBAO_API_KEY=REPLACE_ME
# 方舟 endpoint 与 model id 请到你的控制台核对；下方仅为常见值占位
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_VISION=doubao-seed-2-1-pro
DOUBAO_MODEL_TEXT=doubao-seed-2-1-lite

# ---- 阿里百炼 · Qwen-VL（对照） ----
DASHSCOPE_API_KEY=REPLACE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max

# ---- 腾讯云（候选，Phase 0 若测出可留空） ----
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_EDU_GRADING_ENDPOINT=

# ============================================
# 成本护栏（AGENTS §4 必配）
# ============================================
WENGU_DAILY_CALL_BUDGET_CNY=10       # 每日批量调用上限（超了自动降级或阻断）
WENGU_MODEL_TIER_DEFAULT=value       # value（性价比） | flagship（旗舰）
WENGU_VARIANT_ON_DEMAND=1            # 变式题必须按需触发，禁止后台自动刷
WENGU_CACHE_DIR=/app/data/cache      # 内容哈希三级缓存目录

# 别忘了在**云厂商控制台**同步设置账单硬上限与告警——这不是本应用能替代的

# ============================================
# 可选：云备份（v2.4 KuroTutor 模式，AESGCM+scrypt+git 每日 commit）
# ============================================
# WENGU_BACKUP_ENABLED=0
# WENGU_BACKUP_REPO=https://gitee.com/<你>/wengu-backup.git
# WENGU_BACKUP_TOKEN=                # 私有仓库 PAT
# WENGU_BACKUP_PASSPHRASE=           # scrypt 加密口令，一旦丢失无法恢复

# ============================================
# 可选：远程访问（默认关，走 Tailscale 见 docker-compose.yml）
# ============================================
# TS_AUTHKEY=                        # 若启用 tailscale 服务
