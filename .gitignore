# ---- seed 与外部数据源（本仓库不分发，家长按需自建）----
seeds/*.json
seeds/*.yaml
!seeds/README.md
!seeds/**/.gitkeep

# ---- evals 黄金集（PII 保护：数据文件默认忽略，schema/README 保留）----
evals/**/data/
evals/**/*.json
!evals/**/schema.json
!evals/**/README.md
!evals/**/.gitkeep

