# ---- 运行时数据（本地）----
data/
backups/
wengu-api/data/
wengu-api/uploads/
wengu-api/*.db
wengu-api/*.db-wal
wengu-api/*.db-shm
*.db-journal
logs/
*.log

# ---- seed 数据 ----
# seeds/data/ = 转换后的 cn-math-taxonomy 初中包，随仓库分发（CC BY-NC 4.0，_source.json 内嵌署名）
# seeds/local/ 与 seeds/mappings/ = 家长自建（化学/语文 seed、教材包对照），不进仓库
seeds/*.json
seeds/*.yaml
seeds/local/
seeds/mappings/*.json
!seeds/data/
!seeds/data/**
!seeds/README.md
!seeds/**/.gitkeep

# ---- evals 黄金集（PII 保护：数据文件默认忽略，schema/README 保留）----
evals/**/data/
evals/**/*.json
!evals/**/schema.json
!evals/**/README.md
!evals/**/.gitkeep

# ---- 外部参考（本仓库不分发）----
